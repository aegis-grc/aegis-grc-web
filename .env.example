# Public origin of the deployed site. Unset => noindex + robots Disallow.
PUBLIC_SITE_URL=

# Contact inbox used by mailto links and the contact form fallback.
PUBLIC_CONTACT_EMAIL=hello@aegis-grc.com

# Verified product application sign-in URLs. Leave empty until confirmed;
# /sign-in only renders a link when the value is set.
PUBLIC_APP_URL_GRC=
PUBLIC_APP_URL_AMPLIFY=
PUBLIC_APP_URL_SENTINEL=

# Optional: URL of an approved form service. When set, /contact posts the form there;
# when empty, the form composes a pre-filled email instead.
PUBLIC_FORM_ENDPOINT=
