---
import type { ProductId } from '../data/products';
interface Props {
  product: ProductId;
}
const { product } = Astro.props;
---

<!-- Abstract motifs: no data, no labels. They carry mood and product identity only. -->
<svg class="motif" viewBox="0 0 320 180" fill="none" aria-hidden="true" focusable="false" data-product={product}>
  {
    product === 'grc' && (
      <g>
        <path d="M58 40v100" stroke="var(--accent-line)" stroke-width="1.5" />
        <circle cx="58" cy="40" r="7" fill="var(--bg)" stroke="var(--accent)" stroke-width="1.8" />
        <circle cx="58" cy="90" r="7" fill="var(--bg)" stroke="var(--accent)" stroke-width="1.8" />
        <circle cx="58" cy="140" r="7" fill="var(--accent)" />
        <path d="m54.6 140 2.4 2.4 4-4.6" stroke="var(--accent-ink)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        <rect x="88" y="26" width="196" height="28" rx="8" fill="var(--surface-2)" stroke="var(--line-2)" />
        <rect x="100" y="37" width="84" height="6" rx="3" fill="var(--silver-2)" opacity=".55" />
        <rect x="88" y="76" width="168" height="28" rx="8" fill="var(--surface-2)" stroke="var(--line-2)" />
        <rect x="100" y="87" width="108" height="6" rx="3" fill="var(--silver-2)" opacity=".55" />
        <rect x="88" y="126" width="196" height="28" rx="8" fill="var(--accent-soft)" stroke="var(--accent-line)" />
        <rect x="100" y="137" width="64" height="6" rx="3" fill="var(--accent-bright)" opacity=".8" />
        <rect x="236" y="135" width="36" height="10" rx="5" fill="var(--accent)" opacity=".7" />
      </g>
    )
  }
  {
    product === 'amplify' && (
      <g>
        <path d="M30 150h260" stroke="var(--line-2)" />
        <rect x="42" y="118" width="34" height="32" rx="6" fill="var(--surface-hi)" stroke="var(--line-2)" />
        <rect x="88" y="98" width="34" height="52" rx="6" fill="var(--surface-hi)" stroke="var(--line-2)" />
        <rect x="134" y="76" width="34" height="74" rx="6" fill="var(--accent-soft)" stroke="var(--accent-line)" />
        <rect x="180" y="52" width="34" height="98" rx="6" fill="var(--accent-soft)" stroke="var(--accent-line)" />
        <rect x="226" y="26" width="34" height="124" rx="6" fill="var(--accent)" opacity=".9" />
        <path d="m44 104 46-18 46-24 46-24 46-20" stroke="var(--silver)" stroke-width="1.6" stroke-linecap="round" stroke-dasharray="2 7" />
        <path d="m252 14 12 2-2 12" stroke="var(--silver)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
      </g>
    )
  }
  {
    product === 'sentinel' && (
      <g>
        <path d="M60 24v92" stroke="var(--accent-line)" stroke-width="1.5" />
        <path d="M60 116v30" stroke="var(--accent-line)" stroke-width="1.5" stroke-dasharray="3 5" />
        <circle cx="60" cy="30" r="5" fill="var(--accent)" />
        <circle cx="60" cy="66" r="5" fill="var(--accent)" />
        <circle cx="60" cy="100" r="5" fill="var(--accent)" />
        <rect x="84" y="24" width="150" height="12" rx="6" fill="var(--surface-hi)" />
        <rect x="84" y="60" width="190" height="12" rx="6" fill="var(--surface-hi)" />
        <rect x="84" y="94" width="120" height="12" rx="6" fill="var(--surface-hi)" />
        <rect x="40" y="130" width="240" height="34" rx="10" fill="var(--accent-soft)" stroke="var(--accent-line)" />
        <rect x="54" y="140" width="14" height="14" rx="3" stroke="var(--accent-bright)" stroke-width="1.6" />
        <path d="M59 144v6M63 144v6" stroke="var(--accent-bright)" stroke-width="1.6" stroke-linecap="round" />
        <rect x="80" y="144" width="96" height="6" rx="3" fill="var(--accent-bright)" opacity=".75" />
      </g>
    )
  }
</svg>

<style>
  .motif {
    width: 100%;
    height: auto;
  }
</style>
