---
// Hero artwork: the master shield split into three facets, one per product accent.
// Order matches the hero copy: revenue (Amplify), risk (GRC), security (Sentinel).
---

<svg
  class="hero-mark"
  viewBox="0 0 360 410"
  fill="none"
  role="img"
  aria-label="The Aegis shield, divided into three facets for Aegis Amplify, Aegis GRC, and Aegis Sentinel"
>
  <defs>
    <linearGradient id="hm-amp" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#4d9bff" stop-opacity=".62"></stop>
      <stop offset="1" stop-color="#4d9bff" stop-opacity=".06"></stop>
    </linearGradient>
    <linearGradient id="hm-grc" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#2fc987" stop-opacity=".58"></stop>
      <stop offset="1" stop-color="#2fc987" stop-opacity=".05"></stop>
    </linearGradient>
    <linearGradient id="hm-sen" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#34d1d1" stop-opacity=".55"></stop>
      <stop offset="1" stop-color="#34d1d1" stop-opacity=".05"></stop>
    </linearGradient>
    <clipPath id="hm-clip">
      <path
        transform="scale(11.25)"
        d="M16 1.6 29 6.6v11.4c0 8.7-5.7 13.9-13 16.6C8.7 31.9 3 26.7 3 18V6.6L16 1.6Z"
      ></path>
    </clipPath>
  </defs>

  <g clip-path="url(#hm-clip)">
    <rect class="facet f1" x="30" y="0" width="94" height="410" fill="url(#hm-amp)"></rect>
    <rect class="facet f2" x="124" y="0" width="112" height="410" fill="url(#hm-grc)"></rect>
    <rect class="facet f3" x="236" y="0" width="94" height="410" fill="url(#hm-sen)"></rect>
    <path d="M124 0v410M236 0v410" stroke="rgba(190,206,235,.28)" stroke-width="1"></path>
  </g>

  <path
    class="outline"
    transform="scale(11.25)"
    d="M16 1.6 29 6.6v11.4c0 8.7-5.7 13.9-13 16.6C8.7 31.9 3 26.7 3 18V6.6L16 1.6Z"
    stroke="#c9d3e3"
    stroke-width="0.15"
    stroke-linejoin="round"
    pathLength="1"
  ></path>
  <path
    transform="translate(180 205) scale(.86) translate(-180 -205)"
    d="M180 22 326 78v128c0 98-64 156-146 187C98 362 34 304 34 206V78L180 22Z"
    stroke="rgba(190,206,235,.18)"
    stroke-width="1"
    vector-effect="non-scaling-stroke"
  ></path>
  <path
    class="peak"
    d="M112 268 180 112l68 156M141 215h78"
    stroke="#e8edf5"
    stroke-width="5"
    stroke-linecap="round"
    stroke-linejoin="round"
    pathLength="1"
  ></path>
</svg>

<style>
  .hero-mark {
    width: min(100%, 420px);
    height: auto;
    margin-inline: auto;
    filter: drop-shadow(0 30px 60px rgba(8, 16, 36, 0.8));
  }
  .outline,
  .peak {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    animation: draw 1100ms var(--ease) both;
  }
  .peak {
    animation-delay: 380ms;
  }
  .facet {
    animation: rise 800ms var(--ease) both;
  }
  .f1 {
    animation-delay: 200ms;
  }
  .f2 {
    animation-delay: 320ms;
  }
  .f3 {
    animation-delay: 440ms;
  }
  @keyframes draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>
