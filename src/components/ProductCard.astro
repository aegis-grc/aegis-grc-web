---
import ProductMotif from './ProductMotif.astro';
import ProductGlyph from './ProductGlyph.astro';
import Arrow from './Arrow.astro';
import type { Product } from '../data/products';

interface Props {
  product: Product;
  /** Extra line under the summary */
  note?: string;
}
const { product, note } = Astro.props;
---

<article class="card" data-product={product.id}>
  <div class="art"><ProductMotif product={product.id} /></div>
  <div class="body">
    <p class="cat"><ProductGlyph product={product.id} size={18} />{product.category}</p>
    <h3>{product.name}</h3>
    <p class="summary">{product.summary}</p>
    {note && <p class="note">{note}</p>}
    <a class="more link-arrow" href={product.path}>
      Explore {product.name}
      <Arrow />
    </a>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition:
      border-color var(--t-med) var(--ease),
      transform var(--t-med) var(--ease);
  }
  .card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 2px;
    background: var(--accent);
    opacity: 0.85;
  }
  .art {
    padding: 34px 28px 10px;
    background: radial-gradient(ellipse 80% 90% at 50% 0%, var(--accent-glow), transparent 75%);
  }
  .art :global(.motif) {
    transition: transform var(--t-med) var(--ease);
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 22px 28px 30px;
    flex: 1;
  }
  .cat {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--fs-label);
    color: var(--accent-bright);
    font-weight: 500;
  }
  h3 {
    font-size: 2rem;
  }
  .summary {
    color: var(--text-dim);
  }
  .note {
    font-size: var(--fs-small);
    color: var(--text-faint);
  }
  .more {
    margin-top: auto;
    padding-top: 10px;
  }
  /* Whole card is one link target */
  .more::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  @media (hover: hover) {
    .card:hover {
      border-color: var(--accent-line);
      transform: translateY(-3px);
    }
    .card:hover .art :global(.motif) {
      transform: translateY(-3px);
    }
    .card:hover .more :global(svg) {
      transform: translateX(3px);
    }
  }
</style>
