---
interface Props {
  title: string;
  steps: { label: string; note: string }[];
  product?: 'grc';
}
const { title, steps } = Astro.props;
---

<figure class="flow" data-product="grc">
  <figcaption><span class="dot"></span>{title}</figcaption>
  <ol>
    {
      steps.map((s, i) => (
        <li class:list={{ last: i === steps.length - 1 }}>
          <span class="node" aria-hidden="true"></span>
          <span class="label">{s.label}</span>
          <span class="note">{s.note}</span>
        </li>
      ))
    }
  </ol>
</figure>

<style>
  .flow {
    border: 1px solid var(--line-2);
    border-radius: var(--radius-lg);
    background: var(--surface);
    overflow: hidden;
    box-shadow: 0 40px 80px -40px rgba(0, 0, 0, 0.7);
  }
  figcaption {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 16px 22px;
    border-bottom: 1px solid var(--line-2);
    background: var(--surface-2);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: var(--text-dim);
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }
  ol {
    position: relative;
    padding: 12px 22px 12px 22px;
  }
  li {
    position: relative;
    display: grid;
    grid-template-columns: 22px 1fr;
    column-gap: 16px;
    padding: 14px 0;
  }
  li::before {
    content: '';
    position: absolute;
    left: 10px;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--accent-line);
  }
  li:first-child::before {
    top: 50%;
  }
  li.last::before {
    bottom: 50%;
  }
  .node {
    position: relative;
    z-index: 1;
    grid-row: span 2;
    align-self: center;
    width: 21px;
    height: 21px;
    border-radius: 50%;
    background: var(--bg);
    border: 1.8px solid var(--accent);
  }
  .last .node {
    background: var(--accent);
  }
  .label {
    font-weight: 500;
    color: var(--text);
  }
  .note {
    font-size: var(--fs-small);
    color: var(--text-dim);
  }
</style>
