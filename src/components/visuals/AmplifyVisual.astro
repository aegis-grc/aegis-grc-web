---
// Ascending staircase: the path from first inquiry to booked job. Illustration only.
const stages = [
  { label: 'New lead', note: 'Customer acquisition and lead generation' },
  { label: 'Instant response', note: 'The reply goes out as the lead arrives' },
  { label: 'Nurture', note: 'The conversation keeps moving' },
  { label: 'Appointment', note: 'Booked on the calendar' },
  { label: 'Estimate follow-up', note: 'Stalled estimates get recovered' },
  { label: 'Booked job', note: 'Tracked in the CRM pipeline' },
];
---

<figure class="pipe" data-product="amplify">
  <figcaption><span class="dot"></span>From first inquiry to booked job</figcaption>
  <ol>
    {
      stages.map((s, i) => (
        <li class:list={{ last: i === stages.length - 1 }} style={`--i:${i}`}>
          <span class="label">{s.label}</span>
          <span class="note">{s.note}</span>
        </li>
      ))
    }
  </ol>
  <div class="attr">Attribution connects each job back to the source that started it.</div>
</figure>

<style>
  .pipe {
    border: 1px solid var(--line-2);
    border-radius: var(--radius-lg);
    background: var(--surface);
    overflow: hidden;
    box-shadow: 0 40px 80px -40px rgba(0, 0, 0, 0.7);
  }
  figcaption {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 16px 22px;
    border-bottom: 1px solid var(--line-2);
    background: var(--surface-2);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: var(--text-dim);
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }
  ol {
    display: grid;
    gap: 8px;
    padding: 18px 22px;
  }
  li {
    display: grid;
    gap: 2px;
    padding: 13px 18px;
    margin-left: calc(var(--i) * 3.4%);
    border: 1px solid var(--line-2);
    border-left: 3px solid var(--accent);
    border-radius: 10px;
    background: color-mix(in srgb, var(--accent) calc(var(--i) * 3.5% + 3%), var(--surface));
  }
  .label {
    font-weight: 500;
    color: var(--text);
  }
  .note {
    font-size: var(--fs-small);
    color: var(--text-dim);
  }
  .last {
    background: var(--accent);
    border-color: var(--accent-bright);
  }
  .last .label,
  .last .note {
    color: var(--accent-ink);
  }
  .attr {
    padding: 14px 22px 18px;
    border-top: 1px solid var(--line);
    font-size: var(--fs-small);
    color: var(--silver-2);
  }
  @media (max-width: 520px) {
    li {
      margin-left: calc(var(--i) * 2%);
    }
  }
</style>
