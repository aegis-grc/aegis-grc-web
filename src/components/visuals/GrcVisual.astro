---
// Ledger-style mosaic: the programme as linked records. Illustration only, no data.
const tiles = [
  { label: 'Frameworks', d: 'M4 5h16M4 12h16M4 19h10' },
  { label: 'Risks', d: 'M12 3 3 20h18L12 3Zm0 7v5m0 3h.01' },
  { label: 'Audit evidence', d: 'M6 3h8l4 4v14H6zM14 3v4h4M9 13h6M9 17h4' },
  { label: 'Vendors', d: 'M3 21V8l9-5 9 5v13M9 21v-7h6v7' },
  { label: 'Contracts', d: 'M7 3h7l4 4v14H7zM14 3v5h4M10 13h5M10 17h3' },
  { label: 'Quality & training', d: 'M4 6h16v12H4zM4 10h16M8 14h5' },
];
---

<figure class="ledger" data-product="grc">
  <figcaption>
    <span class="dot"></span>One connected program
  </figcaption>
  <ul>
    {tiles.map((t) => (
      <li>
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d={t.d} />
        </svg>
        <span>{t.label}</span>
      </li>
    ))}
  </ul>
  <div class="foot">
    <span class="bar"></span>
    <span class="bar b2"></span>
    <span class="tag">Audit-ready view</span>
  </div>
</figure>

<style>
  .ledger {
    border: 1px solid var(--line-2);
    border-radius: var(--radius-lg);
    background: var(--surface);
    overflow: hidden;
    box-shadow: 0 40px 80px -40px rgba(0, 0, 0, 0.7);
  }
  figcaption {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 16px 22px;
    border-bottom: 1px solid var(--line-2);
    background: var(--surface-2);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: var(--text-dim);
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }
  ul {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--line);
  }
  li {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 24px 22px;
    background: var(--surface);
    color: var(--text);
    font-weight: 500;
  }
  li svg {
    width: 22px;
    height: 22px;
    flex: none;
    color: var(--accent-bright);
  }
  li:nth-child(5),
  li:nth-child(2) {
    background: var(--surface-2);
  }
  .foot {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 18px 22px;
    border-top: 1px solid var(--line-2);
    background: var(--accent-soft);
  }
  .bar {
    height: 6px;
    width: 72px;
    border-radius: 3px;
    background: var(--accent);
    opacity: 0.7;
  }
  .b2 {
    width: 40px;
    opacity: 0.35;
  }
  .tag {
    margin-left: auto;
    padding: 5px 12px;
    border: 1px solid var(--accent-line);
    border-radius: 999px;
    font-size: var(--fs-label);
    color: var(--accent-bright);
  }
</style>
