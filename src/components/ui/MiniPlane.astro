---
import type { ProductId } from '../../data/products';

/** A tiny abstract thumbnail of a product plane, for the mega-menu and compact lists. */
interface Props {
  product: ProductId;
}
const { product } = Astro.props;
---

<span
  class="mini"
  data-product={product}
  data-theme={product === 'sentinel' ? 'dark' : undefined}
  aria-hidden="true"
>
  {product === 'grc' && (
    <svg viewBox="0 0 120 76" fill="none">
      <rect x="12" y="14" width="40" height="5" rx="2.5" fill="var(--line-2)" />
      <rect x="12" y="30" width="52" height="5" rx="2.5" fill="var(--line-2)" />
      <rect x="12" y="46" width="34" height="5" rx="2.5" fill="var(--line-2)" />
      <g fill="var(--accent)">
        <circle cx="80" cy="16.5" r="5" />
        <circle cx="100" cy="16.5" r="5" />
        <circle cx="80" cy="32.5" r="5" />
      </g>
      <circle
        cx="100"
        cy="32.5"
        r="4.4"
        stroke="var(--accent-text)"
        stroke-width="1.4"
        stroke-dasharray="2.4 2.4"
      />
      <g fill="var(--accent)">
        <circle cx="80" cy="48.5" r="5" />
        <circle cx="100" cy="48.5" r="5" />
      </g>
      <rect x="12" y="62" width="96" height="4" rx="2" fill="var(--accent)" opacity=".25" />
    </svg>
  )}
  {product === 'amplify' && (
    <svg viewBox="0 0 120 76" fill="none">
      <g stroke="var(--line-2)" stroke-width="1.2">
        <rect x="9" y="12" width="24" height="14" rx="4" />
        <rect x="9" y="32" width="24" height="14" rx="4" />
        <rect
          x="40"
          y="12"
          width="24"
          height="14"
          rx="4"
          fill="var(--accent-soft)"
          stroke="var(--accent)"
        />
        <rect x="71" y="12" width="24" height="14" rx="4" />
        <rect x="71" y="32" width="24" height="14" rx="4" />
      </g>
      <path d="M33 19h7" stroke="var(--accent)" stroke-width="1.4" stroke-linecap="round" />
      <rect x="9" y="58" width="68" height="5" rx="2.5" fill="var(--accent)" />
      <rect x="80" y="58" width="31" height="5" rx="2.5" fill="var(--accent)" opacity=".35" />
    </svg>
  )}
  {product === 'sentinel' && (
    <svg viewBox="0 0 120 76" fill="none">
      <g stroke="var(--accent-line)" stroke-width="1.1">
        <path d="M16 14C42 14 48 32 62 32" />
        <path d="M16 28C40 28 48 32 62 32" />
        <path d="M16 42C40 42 48 32 62 32" />
      </g>
      <g stroke="var(--accent-text)" stroke-width="1.3" fill="var(--bg)">
        <circle cx="16" cy="14" r="3" />
        <circle cx="16" cy="28" r="3" />
        <circle cx="16" cy="42" r="3" />
      </g>
      <circle cx="62" cy="32" r="6" fill="var(--accent)" />
      <path d="M68 32h40" stroke="var(--accent-line)" stroke-width="1.1" stroke-dasharray="3 3" />
      <rect
        x="14"
        y="56"
        width="92"
        height="12"
        rx="4"
        fill="var(--accent-soft)"
        stroke="var(--accent-line)"
        stroke-dasharray="3 3"
      />
    </svg>
  )}
</span>

<style>
  .mini {
    display: block;
    aspect-ratio: 120 / 76;
    border: 1px solid var(--line);
    border-radius: 9px;
    background: var(--surface);
    overflow: hidden;
    transition:
      transform var(--t-med) var(--ease),
      border-color var(--t-fast) var(--ease);
  }
  .mini svg {
    width: 100%;
    height: 100%;
  }
</style>
