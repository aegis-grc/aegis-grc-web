---
/**
 * Contracts hero motif: the agreement lifecycle as a loop. Five steps on a ring; the last step (tracking
 * obligations and renewals) returns to the first, so the contract never "ends". Structure only.
 */
interface Props {
  steps: { label: string; note: string }[];
}
const { steps } = Astro.props;
const R = 92;
const C = 120;
const pts = steps.map((_, i) => {
  const a = (-90 + (360 / steps.length) * i) * (Math.PI / 180);
  return { x: C + R * Math.cos(a), y: C + R * Math.sin(a) };
});
const arc = (i: number) => {
  const a = pts[i];
  const b = pts[(i + 1) % pts.length];
  return `M${a.x.toFixed(1)} ${a.y.toFixed(1)} A${R} ${R} 0 0 1 ${b.x.toFixed(1)} ${b.y.toFixed(1)}`;
};
---

<div class="cc" data-product="grc" aria-hidden="true">
  <div class="ringwrap">
    <svg viewBox="0 0 240 240" fill="none">
      <circle cx={C} cy={C} r={R + 26} class="halo"></circle>
      {steps.map((_, i) => (
        <path d={arc(i)} class:list={['seg', { back: i === steps.length - 1 }]}></path>
      ))}
      {pts.map((p, i) => (
        <g>
          <circle
            cx={p.x}
            cy={p.y}
            r="15"
            class:list={['n', { last: i === steps.length - 1 }]}
          ></circle>
          <text x={p.x} y={p.y + 4} text-anchor="middle">
            {i + 1}
          </text>
        </g>
      ))}
    </svg>
    <span class="mid">Renews</span>
  </div>
  <ol class="legend">
    {steps.map((s, i) => (
      <li class:list={{ last: i === steps.length - 1 }}>
        <b>{s.label}</b>
        <span>{s.note}</span>
      </li>
    ))}
  </ol>
</div>

<style>
  .cc {
    display: grid;
    grid-template-columns: minmax(200px, 270px) minmax(0, 1fr);
    align-items: center;
    gap: clamp(16px, 3vw, 36px);
    padding: clamp(20px, 2.6vw, 32px);
    border: 1px solid var(--line);
    border-radius: 22px;
    background: var(--paper);
    box-shadow: var(--shadow-plane);
    max-width: none;
    justify-self: stretch;
  }
  .ringwrap {
    position: relative;
    aspect-ratio: 1;
  }
  .ringwrap svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .halo {
    stroke: var(--line);
    stroke-width: 1;
    stroke-dasharray: 2 5;
  }
  .seg {
    stroke: color-mix(in srgb, var(--grc) 45%, var(--silver));
    stroke-width: 2;
  }
  .seg.back {
    stroke: var(--grc);
    stroke-dasharray: 4 5;
  }
  .n {
    fill: var(--paper);
    stroke: var(--grc);
    stroke-width: 2;
  }
  .n.last {
    fill: var(--grc);
  }
  text {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    fill: var(--grc-text);
  }
  .n.last + text {
    fill: #04140d;
  }
  .mid {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    color: var(--text-faint);
  }
  .legend {
    display: grid;
    gap: 2px;
    counter-reset: s;
  }
  .legend li {
    display: grid;
    grid-template-columns: 22px 1fr;
    column-gap: 10px;
    padding: 8px 0;
    border-top: 1px solid var(--line);
    counter-increment: s;
  }
  .legend li:first-child {
    border-top: 0;
  }
  .legend li::before {
    content: counter(s);
    grid-row: 1 / span 2;
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    color: var(--grc-text);
    padding-top: 3px;
  }
  .legend b {
    font-size: var(--fs-small);
    color: var(--text);
  }
  .legend span {
    font-size: var(--fs-label);
    color: var(--text-dim);
  }
  @media (max-width: 560px) {
    .cc {
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
    }
    .ringwrap {
      width: min(230px, 70%);
    }
    .legend {
      justify-self: stretch;
    }
  }
</style>
