---
/**
 * Security hero: the principles as a controlled stack on one dark plane, ending in the human-approval gate.
 * Titles mirror the Security page principles. No claims of certification or tooling.
 */
interface Props {
  titles: string[];
}
const { titles } = Astro.props;
---

<div class="ss" data-theme="dark" aria-hidden="true">
  <div class="bar">
    <span>Principles</span>
    <span class="st">
      <i></i>Across Aegis products
    </span>
  </div>
  <ol>
    {titles.map((t, i) => (
      <li class:list={{ gate: t === 'Human approval' }}>
        <b>{String(i + 1).padStart(2, '0')}</b>
        <span>{t}</span>
        {t === 'Human approval' && (
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="5" y="11" width="14" height="9" rx="2"></rect>
            <path d="M8 11V8a4 4 0 0 1 8 0v3"></path>
          </svg>
        )}
      </li>
    ))}
  </ol>
</div>

<style>
  .ss {
    max-width: 520px;
    border: 1px solid var(--line-2);
    border-radius: 18px;
    background:
      radial-gradient(
        ellipse 70% 60% at 100% 0%,
        color-mix(in srgb, var(--blue) 22%, transparent),
        transparent 70%
      ),
      var(--navy);
    color: var(--text);
    box-shadow: 0 34px 70px -38px rgba(6, 27, 63, 0.85);
    overflow: hidden;
  }
  .bar {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 13px 20px;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    color: var(--text-faint);
  }
  .bar span:first-child {
    color: var(--blue-lum);
    font-weight: 500;
  }
  .st {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }
  .st i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--brand-green);
  }
  ol {
    display: grid;
    padding: 8px 20px 12px;
  }
  li {
    display: grid;
    grid-template-columns: 30px 1fr auto;
    align-items: center;
    gap: 10px;
    padding: 13px 0;
    border-top: 1px solid var(--line);
    font-size: var(--fs-body);
    font-weight: 500;
  }
  li:first-child {
    border-top: 0;
  }
  li b {
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    font-weight: 400;
    color: var(--text-faint);
  }
  li svg {
    width: 20px;
    height: 20px;
  }
  .gate {
    margin-inline: -20px;
    padding-inline: 20px;
    background: rgba(255, 255, 255, 0.08);
    border-top-color: transparent;
    color: #fff;
  }
  .gate b {
    color: var(--blue-lum);
  }
</style>
