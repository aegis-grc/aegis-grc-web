---
import ProductGlyph from '../ProductGlyph.astro';
import { solutions } from '../../data/solutions';
import { products, type ProductId } from '../../data/products';

/**
 * Solutions hero: problems route to the products that address them. Built from the solutions data, so the
 * picture cannot drift from the page. Desktop draws the routes; mobile shows each problem with its product marks.
 */
const order: ProductId[] = ['grc', 'amplify', 'sentinel'];
const ROW = 56;
const H = solutions.length * ROW;
const cy = (i: number) => (i + 0.5) * ROW;
const py = (k: number) => ((k + 0.5) * H) / order.length;
const lines = solutions.flatMap((s, i) =>
  s.products.map((p) => ({
    p,
    d: `M0 ${cy(i)} C 50 ${cy(i)}, 50 ${py(order.indexOf(p)).toFixed(1)}, 100 ${py(order.indexOf(p)).toFixed(1)}`,
  })),
);
---

<div class="sr" aria-hidden="true">
  <ul class="probs">
    {solutions.map((s) => (
      <li>
        <span>{s.title}</span>
        <span class="m-dots">
          {s.products.map((p) => (
            <i data-product={p}></i>
          ))}
        </span>
      </li>
    ))}
  </ul>
  <svg viewBox={`0 0 100 ${H}`} preserveAspectRatio="none" class="routes">
    {lines.map((l) => (
      <path d={l.d} data-product={l.p} vector-effect="non-scaling-stroke"></path>
    ))}
  </svg>
  <ul class="ports">
    {order.map((p) => (
      <li data-product={p}>
        <ProductGlyph product={p} size={18} />
        <b>{products[p].short}</b>
      </li>
    ))}
  </ul>
</div>

<style>
  .sr {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(48px, 110px) 130px;
    height: calc(var(--rows, 5) * 56px);
    --rows: 5;
    max-width: 640px;
    padding: 8px 0;
  }
  .probs {
    display: grid;
    grid-template-rows: repeat(5, 1fr);
  }
  .probs li {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 16px;
    border-bottom: 1px solid var(--line);
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--text);
    background: color-mix(in srgb, var(--paper) 80%, transparent);
  }
  .probs li:first-child {
    border-top: 1px solid var(--line);
  }
  .m-dots {
    display: none;
  }
  .routes {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .routes path {
    fill: none;
    stroke: var(--p);
    stroke-width: 1.6;
    opacity: 0.75;
  }
  .ports {
    display: grid;
    grid-template-rows: repeat(3, 1fr);
    align-items: center;
  }
  .ports li {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 12px;
    border: 1px solid var(--line-2);
    border-left: 3px solid var(--p);
    border-radius: 10px;
    background: var(--paper);
    box-shadow: var(--shadow-soft);
    color: var(--accent-text);
    align-self: center;
  }
  .ports b {
    font-size: var(--fs-small);
    color: var(--text);
  }
  @media (max-width: 960px) {
    .sr {
      height: auto;
      grid-template-columns: minmax(0, 1fr);
    }
    .routes,
    .ports {
      display: none;
    }
    .probs li {
      justify-content: space-between;
      padding: 14px 4px;
      min-height: 56px;
    }
    .m-dots {
      display: inline-flex;
      flex-wrap: wrap;
      justify-content: flex-end;
      gap: 4px 10px;
    }
    .m-dots em {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      font-style: normal;
      font-family: var(--font-mono);
      font-size: var(--fs-mono);
      color: var(--text-dim);
    }
    .m-dots em::before {
      content: '';
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--p);
    }
  }
</style>
