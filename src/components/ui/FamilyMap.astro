---
import ProductGlyph from '../ProductGlyph.astro';
import AegisLogo from '../brand/AegisLogo.astro';
import { products, grcFamily } from '../../data/products';

/**
 * Company hero: the Aegis family as it is structured. Three products, two GRC family members, and Aria as a
 * layer underneath all of them (a bar, not a branch, so it cannot read as a fourth product).
 */
---

<div class="fm" aria-hidden="true">
  <div class="root">
    <AegisLogo variant="mark" height={56} />
  </div>
  <ul class="branches">
    <li data-product="grc">
      <div class="node">
        <ProductGlyph product="grc" size={18} />
        <b>{products.grc.name}</b>
      </div>
      <ul class="subs">
        {grcFamily.map((m) => (
          <li>{m.name}</li>
        ))}
      </ul>
    </li>
    <li data-product="amplify">
      <div class="node">
        <ProductGlyph product="amplify" size={18} />
        <b>{products.amplify.name}</b>
      </div>
    </li>
    <li data-product="sentinel">
      <div class="node">
        <ProductGlyph product="sentinel" size={18} />
        <b>{products.sentinel.name}</b>
      </div>
    </li>
  </ul>
  <div class="layer">
    <b>Aria</b>
    <span>The shared intelligence layer</span>
  </div>
</div>

<style>
  .fm {
    display: grid;
    grid-template-columns: 76px minmax(0, 1fr);
    column-gap: 22px;
    row-gap: 18px;
    max-width: 560px;
    align-items: center;
  }
  .root {
    display: grid;
    place-items: center;
    height: 76px;
    width: 76px;
    border-radius: 20px;
    background: var(--paper);
    border: 1px solid var(--line-2);
    box-shadow: var(--shadow-plane);
  }
  .branches {
    position: relative;
    display: grid;
    gap: 14px;
  }
  .branches::before {
    content: '';
    position: absolute;
    left: -22px;
    top: 22px;
    bottom: 22px;
    width: 2px;
    background: linear-gradient(var(--grc), var(--amplify), var(--sentinel));
    opacity: 0.55;
  }
  .branches > li {
    position: relative;
    display: grid;
    gap: 8px;
  }
  .branches > li::before {
    content: '';
    position: absolute;
    left: -22px;
    top: 22px;
    width: 22px;
    height: 2px;
    background: var(--p);
    opacity: 0.55;
  }
  .node {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    border: 1px solid var(--line-2);
    border-left: 3px solid var(--p);
    border-radius: 12px;
    background: var(--paper);
    box-shadow: var(--shadow-soft);
    color: var(--accent-text);
  }
  .node b {
    color: var(--text);
    font-size: var(--fs-body);
  }
  .subs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding-left: 16px;
  }
  .subs li {
    padding: 5px 12px;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    font-size: var(--fs-label);
    font-weight: 500;
    color: var(--text-dim);
    background: var(--mist);
  }
  .layer {
    grid-column: 1 / -1;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 6px 14px;
    padding: 14px 22px;
    border-radius: 14px;
    color: #fff;
    background: linear-gradient(90deg, var(--navy), #123f86);
    box-shadow: var(--shadow-soft);
  }
  .layer b {
    font-size: var(--fs-h4);
  }
  .layer span {
    font-size: var(--fs-label);
    color: rgba(255, 255, 255, 0.86);
  }
  @media (max-width: 520px) {
    .fm {
      grid-template-columns: minmax(0, 1fr);
    }
    .root {
      display: none;
    }
    .branches::before,
    .branches > li::before {
      display: none;
    }
  }
</style>
