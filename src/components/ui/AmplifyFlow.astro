---
/**
 * Amplify hero: a lead route that moves across the canvas. Six stages on one rail, a recovery loop from
 * Estimate back into follow-up, and an attribution line from the booked job back to the source.
 * Stages and labels come from the approved capability list. No numbers, no data.
 * Real-screenshot slot: a pipeline or lead-thread crop can sit under the band when one exists.
 * Mobile is its own composition: the rail turns vertical and the two loops become notes in the route.
 */
const sources = ['Lead generation', 'Demand Network', 'Campaigns'];
const stages = [
  { name: 'New lead', note: 'Every inquiry lands in one place' },
  { name: 'Instant reply', note: 'First response, right away' },
  { name: 'Nurture', note: 'Kept warm until ready' },
  { name: 'Appointment', note: 'Booked on the calendar' },
  { name: 'Estimate', note: 'Sent, then followed up' },
  { name: 'Booked job', note: 'Won, and traced to its source' },
];
---

<div class="flow" data-product="amplify" aria-hidden="true">
  <div class="in">
    <span class="in-label">Demand in</span>
    {sources.map((s) => (
      <em>{s}</em>
    ))}
  </div>

  <div class="route">
    <div class="rail">
      <i class="dot d1"></i>
      <i class="dot d2"></i>
      <i class="dot d3"></i>
    </div>
    <ol class="stages">
      {stages.map((s, i) => (
        <li class:list={{ hot: i === 1 }}>
          <b class="node">{String(i + 1).padStart(2, '0')}</b>
          <span class="nm">{s.name}</span>
          <span class="nt">{s.note}</span>
          {i === 4 && <p class="m-note">Quiet estimates re-enter follow-up.</p>}
          {i === 5 && <p class="m-note">Attribution traces the job back to the source.</p>}
        </li>
      ))}
    </ol>
    <div class="loop recover">
      <span>Estimate recovery</span>
    </div>
    <div class="loop attr">
      <span>Attribution</span>
    </div>
  </div>
</div>

<style>
  .flow {
    --band-a: #0a62cc;
    --band-b: #0b49a8;
    --band-label: #0b55b8;
    --node-ink: #0a3f94;
    position: relative;
    display: grid;
    gap: clamp(22px, 3vw, 34px);
    padding: clamp(24px, 3.4vw, 44px) clamp(20px, 3.4vw, 48px) clamp(30px, 4vw, 52px);
    border-radius: 22px;
    color: #fff;
    background:
      radial-gradient(ellipse 60% 90% at 12% 0%, rgba(114, 184, 255, 0.45), transparent 70%),
      radial-gradient(ellipse 50% 80% at 100% 100%, rgba(0, 200, 150, 0.18), transparent 70%),
      linear-gradient(135deg, var(--band-a) 0%, var(--band-b) 100%);
    box-shadow: 0 30px 70px -36px rgba(10, 60, 150, 0.7);
    overflow: hidden;
  }
  .in {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 10px;
    font-size: var(--fs-label);
  }
  .in-label {
    margin-right: 6px;
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    color: rgba(255, 255, 255, 0.86);
  }
  .in em {
    font-style: normal;
    font-weight: 500;
    padding: 5px 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.3);
  }
  .route {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
  }
  .rail {
    position: absolute;
    left: calc(100% / 12);
    right: calc(100% / 12);
    top: 20px;
    height: 2px;
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.9), rgba(255, 255, 255, 0.5));
    border-radius: 1px;
    container-type: inline-size;
  }
  .dot {
    position: absolute;
    left: 0;
    top: -4px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 0 5px rgba(255, 255, 255, 0.22);
    opacity: 0;
    animation: run 6.4s linear infinite;
  }
  .d2 {
    animation-delay: -2.1s;
  }
  .d3 {
    animation-delay: -4.2s;
  }
  @keyframes run {
    0% {
      transform: translateX(0);
      opacity: 0;
    }
    8% {
      opacity: 1;
    }
    92% {
      opacity: 1;
    }
    100% {
      transform: translateX(calc(100cqw - 10px));
      opacity: 0;
    }
  }
  .stages {
    grid-row: 1;
    position: relative;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
  }
  .stages li {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 6px;
    padding-inline: 6px;
  }
  .node {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: #fff;
    color: var(--node-ink);
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    font-weight: 500;
    box-shadow: 0 6px 16px -6px rgba(3, 19, 39, 0.6);
  }
  .hot .node {
    background: #72b8ff;
    color: #031327;
    box-shadow:
      0 0 0 6px rgba(114, 184, 255, 0.3),
      0 6px 16px -6px rgba(3, 19, 39, 0.6);
  }
  .nm {
    margin-top: 6px;
    font-size: var(--fs-body);
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .nt {
    font-size: var(--fs-label);
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.88);
    max-width: 15ch;
  }
  .m-note {
    display: none;
  }

  /* Loops under the rail: recovery (stage 5 back to 3) and attribution (stage 6 back to the source) */
  .loop {
    position: relative;
    height: 44px;
    margin-top: 18px;
    border: 2px dashed rgba(255, 255, 255, 0.7);
    border-top: 0;
    border-radius: 0 0 26px 26px;
  }
  .loop span {
    position: absolute;
    left: 50%;
    bottom: -11px;
    transform: translateX(-50%);
    padding: 2px 12px;
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    background: var(--band-label);
    border-radius: 999px;
    white-space: nowrap;
  }
  .loop::before {
    content: '';
    position: absolute;
    left: -7px;
    top: -2px;
    border: 6px solid transparent;
    border-bottom: 9px solid rgba(255, 255, 255, 0.9);
    border-top: 0;
  }
  .recover {
    grid-column: 1;
    grid-row: 2;
    margin-left: calc(100% / 6 * 2 + 100% / 12);
    margin-right: calc(100% / 6 * 1 + 100% / 12);
  }
  .attr {
    grid-column: 1;
    grid-row: 3;
    height: 62px;
    margin-inline: calc(100% / 12);
    border-color: rgba(255, 255, 255, 0.4);
    border-radius: 0 0 34px 34px;
  }

  @media (prefers-reduced-motion: reduce) {
    .dot {
      animation: none;
      opacity: 0;
    }
  }

  /* Mobile: a vertical route, not a shrunken desktop band */
  @media (max-width: 820px) {
    .rail {
      left: 20px;
      right: auto;
      top: 21px;
      bottom: 21px;
      width: 2px;
      height: auto;
      container-type: size;
      -webkit-mask-image: linear-gradient(#000 82%, transparent);
      mask-image: linear-gradient(#000 82%, transparent);
    }
    .dot {
      left: -4px;
      top: 0;
      animation-name: runY;
    }
    @keyframes runY {
      0% {
        transform: translateY(0);
        opacity: 0;
      }
      8% {
        opacity: 1;
      }
      92% {
        opacity: 1;
      }
      100% {
        transform: translateY(calc(100cqh - 10px));
        opacity: 0;
      }
    }
    .stages {
      grid-template-columns: minmax(0, 1fr);
      gap: 26px;
    }
    .stages li {
      grid-template-columns: 42px 1fr;
      justify-items: start;
      text-align: left;
      column-gap: 18px;
      row-gap: 2px;
      padding-inline: 0;
    }
    .node {
      grid-row: 1 / span 2;
    }
    .nm {
      margin-top: 0;
      align-self: end;
    }
    .nt {
      max-width: none;
      grid-column: 2;
    }
    .m-note {
      display: block;
      grid-column: 2;
      margin-top: 8px;
      padding: 8px 12px;
      border: 1.5px dashed rgba(255, 255, 255, 0.6);
      border-radius: 10px;
      font-size: var(--fs-label);
    }
    .loop {
      display: none;
    }
  }
</style>
