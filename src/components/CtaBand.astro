---
import Arrow from './Arrow.astro';
import ProductGlyph from './ProductGlyph.astro';
import type { ProductId } from '../data/products';

/** A closing statement, not a coloured box: large type, one obvious action, quiet context. */
interface Props {
  title: string;
  text?: string;
  primary: { label: string; href: string };
  secondary?: { label: string; href: string };
  product?: ProductId;
}
const { title, text, primary, secondary, product } = Astro.props;
---

<section class="cta" aria-labelledby="cta-title" data-product={product}>
  <div class="container grid">
    <h2 id="cta-title">{title}</h2>
    <div class="side">
      {text && <p class="lede">{text}</p>}
      <div class="actions">
        <a class="btn btn--primary" href={primary.href}>
          {primary.label}
          <Arrow />
        </a>
        {secondary && (
          <a class="link-arrow" href={secondary.href}>
            {secondary.label}
            <Arrow />
          </a>
        )}
      </div>
      {product && (
        <p class="ctx">
          <ProductGlyph product={product} size={16} />
          Part of the Aegis family
        </p>
      )}
    </div>
  </div>
</section>

<style>
  .cta {
    padding-block: var(--section-y);
    border-top: 1px solid var(--line);
    background: linear-gradient(180deg, var(--paper), var(--mist));
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(28px, 6vw, 96px);
    align-items: end;
  }
  h2 {
    font-size: clamp(2.25rem, 1.2rem + 4vw, 4.5rem);
    letter-spacing: -0.045em;
    line-height: 1;
    max-width: 14ch;
  }
  .side {
    display: grid;
    gap: 22px;
    justify-items: start;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 26px;
  }
  .ctx {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--fs-small);
    color: var(--accent-text);
  }
  @media (max-width: 960px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
