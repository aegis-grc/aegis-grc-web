---
import Logo from './Logo.astro';
import ProductGlyph from './ProductGlyph.astro';
import MiniPlane from './ui/MiniPlane.astro';
import Arrow from './Arrow.astro';
import { nav } from '../data/site';

const path = Astro.url.pathname;
const inProducts = path.startsWith('/products');
const current = (href: string) => (path === href || path.startsWith(href) ? 'page' : undefined);
---

<header class="site-header" id="site-header">
  <div class="container bar">
    <a class="home" href="/" aria-label="Aegis home">
      <Logo size="md" />
    </a>

    <a class="mobile-contact btn btn--primary" href={nav.actions.contact.href}>
      Contact
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      id="menu-toggle"
    >
      <span class="visually-hidden">Menu</span>
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        aria-hidden="true"
      >
        <path class="l1" d="M4 8h16" stroke-linecap="round"></path>
        <path class="l2" d="M4 16h16" stroke-linecap="round"></path>
      </svg>
    </button>

    <div class="drawer" id="site-nav">
      <nav aria-label="Primary">
        <ul class="primary">
          <li class="has-mega" id="products-item">
            <a
              class="top nav-fallback"
              href="/products/"
              aria-current={inProducts ? 'page' : undefined}
            >
              {nav.products.label}
            </a>
            <button
              class="top nav-trigger"
              type="button"
              aria-expanded="false"
              aria-controls="mega-products"
              id="products-trigger"
              data-current={inProducts ? 'true' : undefined}
            >
              {nav.products.label}
              <svg class="chev" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path
                  d="m4 6 4 4 4-4"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                ></path>
              </svg>
            </button>

            <div class="mega" id="mega-products" role="group" aria-label="Products">
              <ul class="mega-products">
                {nav.products.items.map((p) => (
                  <li data-product={p.id}>
                    <a class="mega-item" href={p.href}>
                      <MiniPlane product={p.id} />
                      <span class="mega-name">
                        <ProductGlyph product={p.id} size={16} />
                        {p.name}
                      </span>
                      <span class="mega-desc">{p.description}</span>
                    </a>
                    {p.children.length > 0 && (
                      <ul class="mega-sub">
                        {p.children.map((c) => (
                          <li>
                            <a href={c.href}>{c.name}</a>
                          </li>
                        ))}
                      </ul>
                    )}
                  </li>
                ))}
              </ul>
              <a class="aria-card" href={nav.products.aria.href}>
                <span class="aria-thread" aria-hidden="true"></span>
                <span class="aria-name">{nav.products.aria.label}</span>
                <span class="aria-note">The Aegis intelligence layer, shared across products.</span>
              </a>
              <div class="mega-foot">
                <a class="link-arrow" href={nav.products.all.href}>
                  {nav.products.all.label}
                  <Arrow />
                </a>
                <a class="muted" href="/solutions/">
                  Not sure where to start? Browse solutions
                </a>
              </div>
            </div>
          </li>
          {nav.links.map((l) => (
            <li>
              <a class="top" href={l.href} aria-current={current(l.href)}>
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="actions">
        <a
          class="signin"
          href={nav.actions.signIn.href}
          aria-current={current(nav.actions.signIn.href)}
        >
          {nav.actions.signIn.label}
        </a>
        <a class="btn btn--primary" href={nav.actions.contact.href}>
          {nav.actions.contact.label}
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: rgba(255, 255, 255, 0.88);
    -webkit-backdrop-filter: saturate(160%) blur(14px);
    backdrop-filter: saturate(160%) blur(14px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: var(--nav-h);
    position: relative;
  }
  .home {
    display: inline-flex;
    border-radius: 6px;
  }
  .drawer {
    display: flex;
    align-items: center;
    flex: 1;
    gap: 24px;
    justify-content: space-between;
    margin-left: 32px;
  }
  .primary {
    display: flex;
    align-items: center;
    gap: 2px;
  }
  .top {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 0 14px;
    border: 0;
    background: none;
    border-radius: 8px;
    color: var(--text-dim);
    font-size: var(--fs-small);
    font-weight: 500;
    cursor: pointer;
    transition: color var(--t-fast) var(--ease);
  }
  .top:hover,
  .top[aria-expanded='true'],
  .top[aria-current='page'],
  .top[data-current='true'] {
    color: var(--text);
  }
  li {
    position: relative;
  }
  .chev {
    width: 14px;
    height: 14px;
    transition: transform 180ms var(--ease);
  }
  .nav-trigger[aria-expanded='true'] .chev {
    transform: rotate(180deg);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .signin {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    padding: 0 10px;
    color: var(--text-dim);
    font-size: var(--fs-small);
    font-weight: 500;
  }
  .signin:hover {
    color: var(--text);
  }
  .actions .btn {
    min-height: 42px;
    padding: 8px 18px;
  }

  /* Without JS the trigger is a plain link to /products/; with JS it is a disclosure button */
  :global(.js) .nav-fallback {
    display: none;
  }
  :global(.no-js) .nav-trigger {
    display: none;
  }
  :global(.no-js) .mega {
    display: none;
  }

  /* Mega-menu (desktop): three products with a thumbnail each, plus Aria and a way out */
  .mega {
    position: absolute;
    top: calc(100% + 12px);
    left: -24px;
    width: min(980px, calc(100vw - 2 * var(--gutter)));
    padding: 24px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr)) minmax(0, 0.92fr);
    gap: 8px 22px;
    background: var(--paper);
    border: 1px solid var(--line-2);
    border-radius: 18px;
    box-shadow: var(--shadow-plane);
    visibility: hidden;
    opacity: 0;
    transform: translateY(-6px);
    transform-origin: top left;
    transition:
      opacity 120ms var(--ease),
      transform 120ms var(--ease),
      visibility 0s linear 120ms;
  }
  .has-mega.is-open .mega {
    visibility: visible;
    opacity: 1;
    transform: none;
    transition:
      opacity 180ms var(--ease),
      transform 180ms var(--ease),
      visibility 0s;
  }
  .mega-products {
    display: contents;
  }
  .mega-products > li {
    display: grid;
    align-content: start;
    gap: 10px;
  }
  .mega-item {
    display: grid;
    gap: 10px;
    padding: 10px;
    margin: -10px;
    border-radius: 14px;
  }
  .mega-name {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 560;
    letter-spacing: -0.01em;
    color: var(--text);
  }
  .mega-name :global(svg) {
    color: var(--accent-text);
  }
  .mega-desc {
    font-size: var(--fs-small);
    line-height: 1.45;
    color: var(--text-dim);
  }
  @media (hover: hover) {
    .mega-item:hover :global(.mini) {
      transform: translateY(-2px);
      border-color: var(--accent-line);
    }
  }
  .mega-sub {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  .mega-sub a {
    font-size: var(--fs-small);
    color: var(--text-dim);
    padding: 2px 0;
    border-bottom: 1px solid var(--line-2);
  }
  .mega-sub a:hover {
    color: var(--text);
    border-color: var(--text);
  }
  .aria-card {
    position: relative;
    display: grid;
    align-content: start;
    gap: 6px;
    padding: 18px 18px 18px 22px;
    border-radius: 14px;
    background: var(--mist);
    overflow: hidden;
  }
  .aria-thread {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: linear-gradient(180deg, var(--amplify), var(--sentinel), var(--grc));
  }
  .aria-name {
    font-weight: 560;
    letter-spacing: -0.01em;
  }
  .aria-note {
    font-size: var(--fs-small);
    line-height: 1.45;
    color: var(--text-dim);
  }
  @media (hover: hover) {
    .aria-card:hover .aria-name {
      color: var(--blue-text);
    }
  }
  .mega-foot {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 10px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    font-size: var(--fs-small);
  }
  .mega-foot .muted:hover {
    color: var(--text);
  }

  .mobile-contact {
    display: none;
    margin-left: auto;
    min-height: 40px;
    padding: 8px 16px;
  }
  .menu-toggle {
    display: none;
    width: 46px;
    height: 46px;
    align-items: center;
    justify-content: center;
    background: none;
    border: 1px solid var(--line-2);
    border-radius: 12px;
    cursor: pointer;
  }
  .menu-toggle svg {
    width: 22px;
    height: 22px;
  }
  .menu-toggle path {
    transform-origin: 12px 12px;
    transition:
      transform 180ms var(--ease),
      opacity var(--t-fast) var(--ease);
  }
  .menu-toggle[aria-expanded='true'] .l1 {
    transform: translateY(4px) rotate(45deg);
  }
  .menu-toggle[aria-expanded='true'] .l2 {
    transform: translateY(-4px) rotate(-45deg);
  }

  @media (max-width: 1060px) {
    .menu-toggle {
      display: inline-flex;
    }
    .mobile-contact {
      display: inline-flex;
    }
    :global(.no-js) .mobile-contact {
      display: none;
    }
    .drawer {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      margin: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      max-height: calc(100dvh - var(--nav-h));
      overflow-y: auto;
      padding: 8px var(--gutter) 28px;
      background: var(--paper);
      border-bottom: 1px solid var(--line);
    }
    .site-header.menu-open .drawer,
    :global(.no-js) .drawer {
      display: flex;
    }
    :global(.no-js) .menu-toggle {
      display: none;
    }
    .primary {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }
    .primary > li {
      border-bottom: 1px solid var(--line);
    }
    .top {
      width: 100%;
      min-height: 52px;
      padding: 0;
      font-size: 1.0625rem;
    }
    .nav-trigger {
      display: none;
    }
    :global(.js) .nav-fallback {
      display: inline-flex;
    }
    :global(.no-js) .mega {
      display: grid;
    }
    .nav-fallback {
      color: var(--text);
    }
    .mega {
      position: static;
      width: auto;
      padding: 0 0 14px;
      display: block;
      background: none;
      border: 0;
      box-shadow: none;
      visibility: visible;
      opacity: 1;
      transform: none;
    }
    .mega-products {
      display: grid;
      gap: 2px;
    }
    .mega-item {
      grid-template-columns: 1fr;
      gap: 2px;
      margin: 0;
      padding: 10px 0;
    }
    .mega-item :global(.mini) {
      display: none;
    }
    .mega-sub {
      padding-left: 24px;
    }
    .aria-card {
      margin-top: 8px;
    }
    .mega-foot {
      margin-top: 12px;
      padding-top: 12px;
    }
    .actions {
      flex-direction: column;
      align-items: stretch;
      gap: 6px;
      margin-top: 18px;
    }
    .actions .btn {
      width: 100%;
      min-height: 48px;
    }
    .signin {
      justify-content: center;
      min-height: 48px;
      border: 1px solid var(--line-2);
      border-radius: 999px;
    }
  }
  @media (max-width: 379px) {
    .mobile-contact {
      display: none;
    }
  }
</style>
