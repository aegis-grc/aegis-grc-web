---
import Logo from './Logo.astro';
import { footer } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="grid">
      <div class="brand">
        <a href="/" aria-label="Aegis home"><Logo size="md" /></a>
        <p>{footer.blurb}</p>
      </div>
      {
        footer.groups.map((g) => (
          <nav aria-label={g.title}>
            <h2 class="col-title">{g.title}</h2>
            <ul>
              {g.links.map((l) => (
                <li class:list={[{ indent: 'indent' in l && l.indent }]}>
                  <a href={l.href}>{l.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>
    <div class="legal">
      <p>&copy; {year} Aegis. All rights reserved.</p>
      <ul>
        {footer.legal.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--bg-2);
    border-top: 1px solid var(--line);
    padding: clamp(48px, 6vw, 80px) 0 28px;
  }
  .grid {
    display: grid;
    grid-template-columns: 1.5fr repeat(4, 1fr);
    gap: 40px;
    margin-bottom: 48px;
  }
  .brand p {
    margin-top: 18px;
    max-width: 30ch;
    color: var(--text-dim);
    font-size: var(--fs-small);
  }
  .col-title {
    font-family: var(--font-body);
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--text-faint);
    margin-bottom: 14px;
  }
  li a {
    display: inline-block;
    padding: 5px 0;
    font-size: var(--fs-small);
    color: var(--text-dim);
    transition: color var(--t-fast) var(--ease);
  }
  li a:hover {
    color: var(--text);
  }
  .indent {
    padding-left: 14px;
  }
  .legal {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    font-size: var(--fs-label);
    color: var(--text-faint);
  }
  .legal ul {
    display: flex;
    gap: 22px;
  }
  .legal a {
    color: var(--text-dim);
  }
  .legal a:hover {
    color: var(--text);
  }
  @media (max-width: 960px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
    .brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 520px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
</style>
