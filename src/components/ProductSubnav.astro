---
import ProductGlyph from './ProductGlyph.astro';
import { products, type ProductId } from '../data/products';
interface Props {
  product: ProductId;
  items: { label: string; href: string }[];
  cta: { label: string; href: string };
}
const { product, items, cta } = Astro.props;
const name = products[product].name;
---

<div class="subnav" data-product={product}>
  <div class="container inner">
    <span class="who">
      <ProductGlyph product={product} size={18} />
      {name}
    </span>
    <nav aria-label="On this page">
      <ul>
        {items.map((i) => (
          <li>
            <a href={i.href}>{i.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <a class="btn btn--accent" href={cta.href}>
      {cta.label}
    </a>
  </div>
</div>

<style>
  .subnav {
    position: sticky;
    top: var(--nav-h);
    z-index: 900;
    background: var(--bg);
    border-block: 1px solid var(--line);
  }
  .inner {
    display: flex;
    align-items: center;
    gap: 28px;
    min-height: 48px;
  }
  .who {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex: none;
    font-weight: 500;
    font-size: var(--fs-small);
    color: var(--accent-bright);
    padding-right: 20px;
    border-right: 1px solid var(--line-2);
  }
  nav {
    flex: 1;
    min-width: 0;
  }
  ul {
    display: flex;
    gap: 4px;
    overflow-x: auto;
    scrollbar-width: none;
  }
  ul::-webkit-scrollbar {
    display: none;
  }
  a:not(.btn) {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 12px;
    white-space: nowrap;
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--text-dim);
    border-radius: 8px;
  }
  a:not(.btn):hover {
    color: var(--text);
  }
  .btn {
    min-height: 38px;
    padding: 6px 16px;
  }
  @media (max-width: 960px) {
    .inner {
      gap: 14px;
    }
    .btn {
      display: none;
    }
  }
</style>
