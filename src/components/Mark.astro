---
// Provisional Aegis master mark: a solid shield with a faceted left plane and an inner peak
// (an "A" without a crossbar-check). Not a checkmark, so it does not read as "compliance".
// It follows the surrounding theme: --text for the shield, --bg for the cut-out peak.
interface Props {
  size?: number;
  class?: string;
}
const { size = 32, class: className } = Astro.props;
---

<svg
  class:list={['mark', className]}
  width={size}
  height={size * 1.125}
  viewBox="0 0 32 36"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <path
    d="M16 1.6 29 6.6v11.4c0 8.7-5.7 13.9-13 16.6C8.7 31.9 3 26.7 3 18V6.6L16 1.6Z"
    fill="var(--text)"
  ></path>
  <path d="M16 1.6 3 6.6v11.4c0 8.7 5.7 13.9 13 16.6Z" fill="var(--bg)" opacity=".18"></path>
  <path
    d="m10 24.2 6-13.7 6 13.7M12.8 19.4h6.4"
    stroke="var(--bg)"
    stroke-width="2.2"
    stroke-linecap="round"
    stroke-linejoin="round"
  ></path>
</svg>
