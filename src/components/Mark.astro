---
// Provisional neutral Aegis master mark: the existing shield silhouette with a
// faceted left plane and an inner peak. Deliberately not a checkmark, so it does
// not read as "compliance". Colours come from CSS so it works on any surface.
interface Props {
  size?: number;
  class?: string;
}
const { size = 32, class: className } = Astro.props;
---

<svg
  class:list={['mark', className]}
  width={size}
  height={size * 1.125}
  viewBox="0 0 32 36"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <path d="M16 1.6 3 6.6v11.4c0 8.7 5.7 13.9 13 16.6Z" fill="rgba(233,239,248,.07)"></path>
  <path
    d="M16 1.6 29 6.6v11.4c0 8.7-5.7 13.9-13 16.6C8.7 31.9 3 26.7 3 18V6.6L16 1.6Z"
    stroke="var(--silver-2)"
    stroke-width="1.5"
    stroke-linejoin="round"></path>
  <path
    d="m10 24.2 6-13.7 6 13.7M12.7 19.6h6.6"
    stroke="var(--text)"
    stroke-width="1.9"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
</svg>
