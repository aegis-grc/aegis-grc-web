---
import { abs, siteConfigured } from '../lib/seo';
import { siteName } from '../data/site';

interface Props {
  title: string;
  description: string;
  path: string;
  noindex?: boolean;
  schema?: object[];
  ogImage?: string;
}
const { title, description, path, noindex = false, schema = [], ogImage = '/og/aegis.png' } =
  Astro.props;

const canonical = abs(path, Astro.site);
const image = abs(ogImage, Astro.site);
const robots = !siteConfigured || noindex ? 'noindex, nofollow' : 'index, follow';
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
{canonical && <link rel="canonical" href={canonical} />}

<meta property="og:site_name" content={siteName} />
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{canonical && <meta property="og:url" content={canonical} />}
{image && <meta property="og:image" content={image} />}
{image && <meta property="og:image:alt" content="The Aegis shield mark on a deep navy background" />}
<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{image && <meta name="twitter:image" content={image} />}

{schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
