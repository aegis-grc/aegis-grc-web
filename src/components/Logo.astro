---
import Mark from './Mark.astro';
import ProductGlyph from './ProductGlyph.astro';
import { products, type ProductId } from '../data/products';

interface Props {
  /** Show a product lockup: Aegis | glyph Product */
  product?: ProductId;
  size?: 'sm' | 'md' | 'lg';
}
const { product, size = 'md' } = Astro.props;
const p = product ? products[product] : undefined;
const markSize = { sm: 22, md: 26, lg: 34 }[size];
---

<span class:list={['lockup', `lockup--${size}`]} data-product={product}>
  <Mark size={markSize} />
  <span class="word">Aegis</span>
  {p && (
    <>
      <span class="sep" aria-hidden="true" />
      <span class="prod">
        <ProductGlyph product={p.id} size={size === 'lg' ? 20 : 17} />
        {p.short}
      </span>
    </>
  )}
</span>

<style>
  .lockup {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    line-height: 1;
    max-width: 100%;
  }
  .lockup :global(.mark) {
    flex: none;
  }
  .word {
    font-weight: 650;
    letter-spacing: -0.03em;
    font-size: 1.4rem;
    color: var(--text);
  }
  .lockup--sm .word {
    font-size: 1.15rem;
  }
  .lockup--lg .word {
    font-size: clamp(1.5rem, 6.2vw, 1.9rem);
  }
  .sep {
    width: 1px;
    align-self: stretch;
    min-height: 1.1em;
    background: var(--line-2);
    margin-inline: 4px;
  }
  .prod {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--accent-text);
    font-weight: 560;
    font-size: 1.0625rem;
    letter-spacing: -0.015em;
  }
</style>
