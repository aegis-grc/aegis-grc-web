---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SentinelVisual from '../../components/visuals/SentinelVisual.astro';
import CtaBand from '../../components/CtaBand.astro';
import Arrow from '../../components/Arrow.astro';
import { products, ariaPath } from '../../data/products';
import { productSchema, breadcrumbSchema } from '../../lib/seo';

const p = products.sentinel;
const description =
  'Aegis Sentinel is AI-native security operations: alert ingestion, correlation, investigation, and case management, with human approval for consequential actions.';

const workflow = [
  {
    title: 'Alert ingestion',
    text: 'Bring alerts from your security tools into one place to work from.',
  },
  {
    title: 'Deterministic deduplication and correlation',
    text: 'Duplicate alerts are collapsed and related alerts are grouped by explicit rules, so the same input gives the same result.',
  },
  {
    title: 'Investigation workflows',
    text: 'Work each investigation through a defined workflow rather than an ad hoc set of tabs.',
  },
  {
    title: 'Case management and evidence timelines',
    text: 'Every finding lands in a case, with an evidence timeline that shows how the investigation unfolded.',
  },
  {
    title: 'Gated, plan-only containment',
    text: 'Sentinel prepares containment plans for people to review. Consequential actions wait for human approval.',
  },
];

const sources = [
  { name: 'CrowdStrike', note: 'Endpoint and identity detections' },
  {
    name: 'Microsoft Defender, Entra, and Purview',
    note: 'Microsoft security and identity signals',
  },
  { name: 'AWS', note: 'Security telemetry from AWS' },
  { name: 'Cloudflare', note: 'Edge and network security signals' },
];

const controls = [
  {
    title: 'Human approval for consequential actions',
    text: 'Anything with real impact waits for a person to decide.',
  },
  {
    title: 'Group-based approvals',
    text: 'Assign approval to the right group, not to whoever happens to be online.',
  },
  {
    title: 'Bounded autonomy',
    text: 'What automation can do on its own is limited, and the limits are explicit.',
  },
  {
    title: 'Kill switch',
    text: 'A way to halt automated activity when you need to.',
  },
  {
    title: 'Entra single sign-on',
    text: 'Sign in with the identity provider your organization already uses.',
  },
  {
    title: 'Tamper-evident audit logging',
    text: 'Actions are logged in a way designed to show tampering, so you can review what happened and who approved it.',
  },
];
---

<BaseLayout
  title="Aegis Sentinel: AI-native security operations"
  description={description}
  path={p.path}
  product="sentinel"
  schema={[
    productSchema(p, description, Astro.site),
    breadcrumbSchema(
      [
        { name: 'Aegis', path: '/' },
        { name: 'Products', path: '/products/' },
        { name: 'Aegis Sentinel', path: p.path },
      ],
      Astro.site,
    ),
  ]}
>
  <PageHero
    product="sentinel"
    lockup
    title="AI-native security operations, with people in control."
    lede="Aegis Sentinel brings alert ingestion, correlation, investigation, and case management into one workflow. AI assists the analyst, and consequential actions wait for human approval."
    crumbs={[
      { name: 'Aegis', href: '/' },
      { name: 'Products', href: '/products/' },
      { name: 'Aegis Sentinel' },
    ]}
  >
    <Fragment slot="actions">
      <a class="btn btn--accent" href="/contact/?topic=sentinel">
        Request a briefing
        <Arrow />
      </a>
      <a class="btn btn--ghost" href="#workflow">
        See the workflow
      </a>
    </Fragment>
    <SentinelVisual slot="visual" />
  </PageHero>

  <section
    class="section section--tint"
    id="workflow"
    aria-labelledby="workflow-title"
    data-product="sentinel"
  >
    <div class="container split">
      <div class="stack sticky">
        <span class="eyebrow">Workflow</span>
        <h2 id="workflow-title">From alert to a decision a person makes.</h2>
        <p class="lede">
          Sentinel does the assembly work: ingesting, correlating, and organizing evidence. The
          decisions that matter stay with your team.
        </p>
      </div>
      <ul class="rows">
        {workflow.map((w) => (
          <li>
            <h3>{w.title}</h3>
            <p>{w.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" id="sources" aria-labelledby="sources-title" data-product="sentinel">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Multi-vendor hunting</span>
        <h2 id="sources-title">Hunt across the tools you already run.</h2>
        <p class="lede">
          Sentinel works across vendors, so an investigation is not limited to one console.
        </p>
      </div>
      <ul class="sources">
        {sources.map((s) => (
          <li>
            <h3>{s.name}</h3>
            <p>{s.note}</p>
          </li>
        ))}
      </ul>
      <p class="note legal-note">
        Product and company names belong to their respective owners. Their use here does not imply
        endorsement.
      </p>
    </div>
  </section>

  <section
    class="section section--tint"
    id="control"
    aria-labelledby="control-title"
    data-product="sentinel"
  >
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Control</span>
        <h2 id="control-title">Autonomy with limits.</h2>
        <p class="lede">
          Sentinel is built so that AI assistance stays inside boundaries your team sets, and every
          consequential step has a person behind it.
        </p>
      </div>
      <ul class="cols-3 ctrl">
        {controls.map((c) => (
          <li>
            <h3>{c.title}</h3>
            <p>{c.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section
    class="section"
    id="safeguards"
    aria-labelledby="safeguards-title"
    data-product="sentinel"
  >
    <div class="container split split--even">
      <div class="stack">
        <span class="eyebrow">AI safeguards</span>
        <h2 id="safeguards-title">Guardrails for the AI itself.</h2>
      </div>
      <ul class="rows">
        <li>
          <h3>Prompt-injection defenses</h3>
          <p>
            Alerts and logs contain text an attacker can influence. Sentinel includes defenses
            against prompt injection from the data it analyzes.
          </p>
        </li>
        <li>
          <h3>Sensitive-data egress controls</h3>
          <p>Controls that limit how sensitive data can leave your environment through AI use.</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="section section--tight aria-note" data-product="sentinel" aria-label="About Aria">
    <div class="container stack">
      <p class="lede">
        Aegis Sentinel is part of the Aegis family. Aria, the Aegis intelligence layer, is the
        shared approach to AI across Aegis products.
      </p>
      <a class="link-arrow" href={ariaPath}>
        Meet Aria
        <Arrow />
      </a>
    </div>
  </section>

  <CtaBand
    title="See how Sentinel would work in your security operations."
    text="Request a briefing and tell us which tools your team works in today."
    primary={{ label: 'Request a briefing', href: '/contact/?topic=sentinel' }}
    secondary={{ label: 'Explore all products', href: '/products/' }}
  />
</BaseLayout>

<style>
  /* Control-room treatment: a quiet instrument grid behind the hero */
  :global([data-product='sentinel'] .page-hero)::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(52, 209, 209, 0.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(52, 209, 209, 0.05) 1px, transparent 1px);
    background-size: 56px 56px;
    -webkit-mask-image: radial-gradient(ellipse 70% 80% at 80% 20%, #000 10%, transparent 75%);
    mask-image: radial-gradient(ellipse 70% 80% at 80% 20%, #000 10%, transparent 75%);
    pointer-events: none;
  }
  .sources {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line-2);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .sources li {
    padding: 28px 24px;
    background: var(--surface);
  }
  .sources h3 {
    font-size: 1.5rem;
    margin-bottom: 8px;
  }
  .sources p {
    color: var(--text-dim);
    font-size: var(--fs-small);
  }
  .legal-note {
    margin-top: 22px;
    font-size: var(--fs-label);
    color: var(--text-faint);
  }
  .ctrl {
    gap: 28px;
  }
  .ctrl li {
    padding-top: 22px;
    border-top: 1px solid var(--line-2);
  }
  .ctrl h3 {
    margin-bottom: 8px;
  }
  .ctrl p {
    color: var(--text-dim);
  }
  @media (max-width: 960px) {
    .sources {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 520px) {
    .sources {
      grid-template-columns: 1fr;
    }
  }
</style>
