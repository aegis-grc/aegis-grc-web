---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import ProductSubnav from '../../../components/ProductSubnav.astro';
import GrcVisual from '../../../components/visuals/GrcVisual.astro';
import CtaBand from '../../../components/CtaBand.astro';
import Arrow from '../../../components/Arrow.astro';
import { products } from '../../../data/products';
import { productSchema, breadcrumbSchema } from '../../../lib/seo';

const p = products.grc;
const description =
  'Aegis GRC brings compliance, risk, audit, vendor management, contracts, quality management, and learning into one connected, AI-assisted platform.';

const before = [
  {
    title: 'Contracts, policies, vendor risk, and training in separate places',
    text: 'Contracts sit in an e-signature tool, policies in a shared drive, vendor risk in a spreadsheet, training in a separate system, and audit prep in email threads.',
  },
  {
    title: 'Audit prep is a scramble',
    text: 'Evidence is collected by hand, controls are not mapped to anything, and every security questionnaire starts from scratch.',
  },
  {
    title: 'Vendor risk is a blind spot',
    text: 'Vendors are onboarded with a PDF and reviewed once a year, if at all, and their sub-processors go unseen.',
  },
];
const after = [
  {
    title: 'One platform, one audit trail',
    text: 'Contracts, policies, vendor reviews, and training records live in one place: connected, searchable, and ready for an audit.',
  },
  {
    title: 'A program that stays current',
    text: 'Controls are mapped to frameworks, evidence is collected as work happens, and questionnaire answers are drafted by AI for your team to review.',
  },
  {
    title: 'Vendors you can see',
    text: 'Every vendor is scored and every contract tracked, with fourth-party risk surfaced between reviews.',
  },
];

const frameworks = [
  { name: 'HIPAA', note: 'Protection of health information' },
  { name: 'SOC 2', note: 'Service organization controls' },
  { name: 'ISO 27001', note: 'Information security management' },
  { name: 'GDPR', note: 'Personal data protection in the EU' },
  { name: 'NIST CSF', note: 'Cybersecurity framework' },
];

const steps = [
  {
    title: 'Connect and configure',
    text: 'Choose your product, activate the modules you need, and connect your existing tools.',
  },
  {
    title: 'Build your Playbook',
    text: 'Import your policies and standard answers once. Drafting, questionnaire answers, and risk scoring all draw on the same shared context.',
  },
  {
    title: 'Automate the work',
    text: 'Draft contracts, prepare security questionnaire answers, score vendors, map controls, and assign training. People approve; they do not chase.',
  },
  {
    title: 'Prove trust continuously',
    text: 'Publish your Trust Center, generate audit evidence on demand, and keep your posture current between reviews.',
  },
];

const security = [
  {
    title: 'Tenant isolation',
    text: 'Each workspace is logically isolated, with scoped access to its own data.',
  },
  {
    title: 'Encryption',
    text: 'Data is encrypted in transit and at rest.',
  },
  {
    title: 'Tamper-evident audit logging',
    text: 'Actions are recorded to an audit trail designed to show tampering, giving you evidence you can hand to an auditor.',
  },
];
---

<BaseLayout
  title="Aegis GRC: governance, risk, and compliance"
  description={description}
  path={p.path}
  product="grc"
  schema={[
    productSchema(p, description, Astro.site),
    breadcrumbSchema(
      [
        { name: 'Aegis', path: '/' },
        { name: 'Products', path: '/products/' },
        { name: 'Aegis GRC', path: p.path },
      ],
      Astro.site,
    ),
  ]}
>
  <PageHero
    product="grc"
    lockup
    title="Run governance, risk, and compliance as one connected program."
    lede="Aegis GRC brings compliance, risk, audit, vendor management, contracts, quality management, and learning into one platform, with AI that works from your own policies and playbook."
    crumbs={[{ name: 'Aegis', href: '/' }, { name: 'Products', href: '/products/' }, { name: 'Aegis GRC' }]}
  >
    <Fragment slot="actions">
      <a class="btn btn--accent" href="/contact/?topic=grc">Contact sales<Arrow /></a>
      <a class="btn btn--ghost" href="#how">See how it works</a>
    </Fragment>
    <GrcVisual slot="visual" />
  </PageHero>

  <ProductSubnav
    product="grc"
    items={[
      { label: 'The problem', href: '#problem' },
      { label: 'Platform', href: '#platform' },
      { label: 'Frameworks', href: '#frameworks' },
      { label: 'How it works', href: '#how' },
      { label: 'Who it is for', href: '#audiences' },
      { label: 'Security', href: '#security' },
    ]}
    cta={{ label: 'Contact sales', href: '/contact/?topic=grc' }}
  />

  <section class="section" id="problem" aria-labelledby="problem-title" data-product="grc">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">The problem</span>
        <h2 id="problem-title">Five tools, zero visibility.</h2>
        <p class="lede">
          Compliance is a coordination problem before it is a documentation problem. When the work
          is scattered, so is the evidence.
        </p>
      </div>
      <div class="contrast">
        <div>
          <h3>Before</h3>
          <ul>
            {
              before.map((b) => (
                <li>
                  <strong>{b.title}</strong>
                  <span>{b.text}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h3>With Aegis GRC</h3>
          <ul>
            {
              after.map((a) => (
                <li>
                  <strong>{a.title}</strong>
                  <span>{a.text}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tint" id="platform" aria-labelledby="platform-title" data-product="grc">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">The platform</span>
        <h2 id="platform-title">Everything the program needs, in one place.</h2>
        <p class="lede">
          Activate the modules you need today. They share one Company Playbook, so the AI in each
          one works from the same context.
        </p>
      </div>
      <div class="cols-2">
        <article class="group">
          <h3>Contracts</h3>
          <p>
            AI-powered contract lifecycle from first draft to renewal, driven by your playbook
            rather than a generic template.
          </p>
          <ul class="tags">
            <li>AI drafting and redlining</li>
            <li>E-signatures</li>
            <li>Obligation tracking</li>
            <li>Renewal alerts</li>
            <li>Contract repository</li>
            <li>Company Playbook</li>
          </ul>
          <a class="link-arrow" href="/products/grc/contracts/">Explore Aegis Contracts<Arrow /></a>
        </article>
        <article class="group">
          <h3>Quality management (QMS)</h3>
          <p>
            Document control for audit-ready teams: SOPs, policies, training records, and approval
            workflows that stay version-controlled and current.
          </p>
          <ul class="tags">
            <li>Version-controlled documents</li>
            <li>SOP and policy management</li>
            <li>Approval and review workflows</li>
            <li>Audit trail</li>
          </ul>
          <a class="link-arrow" href="/products/grc/qms/">Explore Aegis QMS<Arrow /></a>
        </article>
        <article class="group">
          <h3>Risk, audit, and compliance</h3>
          <p>
            From risk identification to audit evidence, with controls mapped to the frameworks your
            customers ask about.
          </p>
          <ul class="tags">
            <li>Risk register</li>
            <li>Audit management</li>
            <li>Evidence collection</li>
            <li>Control mapping</li>
            <li>Security questionnaire AI</li>
          </ul>
        </article>
        <article class="group">
          <h3>Vendors, learning, and trust</h3>
          <p>
            Every third party scored, every employee trained, and a public Trust Center that answers
            due-diligence questions before they are asked.
          </p>
          <ul class="tags">
            <li>Vendor lifecycle</li>
            <li>Vendor risk portal</li>
            <li>Fourth-party risk</li>
            <li>Learning (LMS)</li>
            <li>Trust Center</li>
            <li>Security awareness</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <section class="section" id="frameworks" aria-labelledby="frameworks-title" data-product="grc">
    <div class="container split">
      <div class="stack sticky">
        <span class="eyebrow">Frameworks</span>
        <h2 id="frameworks-title">Map your program to the frameworks your customers ask about.</h2>
        <p class="note">
          Aegis GRC helps you organize and evidence your program. It does not certify compliance:
          certification and attestation come from auditors and regulators.
        </p>
      </div>
      <ul class="rows fw">
        {
          frameworks.map((f) => (
            <li>
              <h3>{f.name}</h3>
              <p>{f.note}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--tint" id="how" aria-labelledby="how-title" data-product="grc">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">How it works</span>
        <h2 id="how-title">Your whole program, connected in four steps.</h2>
      </div>
      <ol class="steps">
        {
          steps.map((s) => (
            <li>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" id="audiences" aria-labelledby="audiences-title" data-product="grc">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Who it is for</span>
        <h2 id="audiences-title">Built for specific teams.</h2>
        <p class="lede">
          Aegis GRC is designed for organizations that need a real program without an enterprise
          implementation.
        </p>
      </div>
      <div class="cols-2">
        <article class="group">
          <h3>Scale-ups and mid-market teams</h3>
          <p>
            You have outgrown spreadsheets and point tools. Real contracts are being signed and real
            vendor exposure is accumulating, and you need an actual GRC program without a dedicated
            compliance hire.
          </p>
        </article>
        <article class="group">
          <h3>Healthcare IT and SaaS</h3>
          <p>
            You handle protected health information and need HIPAA documented before the next
            enterprise deal closes. Your program lives in a shared drive and security reviews are
            scrambles.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="section section--tint" id="msp" aria-labelledby="msp-title" data-product="grc">
    <div class="container split split--even">
      <div class="stack">
        <span class="eyebrow">MSPs and vCISOs</span>
        <h2 id="msp-title">Run every client's program from one platform.</h2>
        <p class="lede">
          If you manage compliance for several clients, you need a multi-tenant platform, not one
          tool per client.
        </p>
      </div>
      <ul class="rows">
        <li>
          <h3>Super admin controls</h3>
          <p>Manage all of your client workspaces from a single administrative view.</p>
        </li>
        <li>
          <h3>Tenant isolation</h3>
          <p>Each client's workspace and data are kept separate.</p>
        </li>
        <li>
          <h3>Per-client module configuration</h3>
          <p>Turn on only the modules each client needs.</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="section" id="security" aria-labelledby="security-title" data-product="grc">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Security</span>
        <h2 id="security-title">A platform that holds your compliance data should be built carefully.</h2>
      </div>
      <ul class="cols-3 rows-cols">
        {
          security.map((s) => (
            <li>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ul>
      <p class="more"><a class="link-arrow" href="/security/">How Aegis approaches security<Arrow /></a></p>
    </div>
  </section>

  <CtaBand
    title="Talk to us about your program."
    text="Aegis GRC pricing is scaled to your team size and the modules you turn on. Tell us what you need and we will put together a quote."
    primary={{ label: 'Contact sales', href: '/contact/?topic=grc' }}
    secondary={{ label: 'Explore Aegis Contracts', href: '/products/grc/contracts/' }}
  />
</BaseLayout>

<style>
  .fw h3 {
    font-size: 2rem;
  }
  .rows-cols {
    gap: 28px;
  }
  .rows-cols li {
    padding-top: 22px;
    border-top: 1px solid var(--line-2);
  }
  .rows-cols h3 {
    margin-bottom: 8px;
  }
  .rows-cols p {
    color: var(--text-dim);
  }
  .more {
    margin-top: 36px;
  }
</style>
