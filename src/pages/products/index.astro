---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ProductMotif from '../../components/ProductMotif.astro';
import ProductGlyph from '../../components/ProductGlyph.astro';
import CtaBand from '../../components/CtaBand.astro';
import Arrow from '../../components/Arrow.astro';
import { productList, grcFamily, ariaPath } from '../../data/products';
import { breadcrumbSchema } from '../../lib/seo';

const detail: Record<string, { text: string; tags: string[] }> = {
  grc: {
    text: 'Compliance, risk, audit, vendor management, contracts, quality management, and learning in one connected program, with AI that works from your own policies and playbook.',
    tags: ['Compliance', 'Risk', 'Audit', 'Vendors', 'Contracts', 'QMS', 'Learning', 'Trust Center'],
  },
  amplify: {
    text: 'AI-native sales, marketing, and revenue operations for contractors and home-service businesses, from lead response to estimate follow-up and attribution.',
    tags: ['Lead response', 'Nurturing', 'Estimate recovery', 'CRM', 'Attribution'],
  },
  sentinel: {
    text: 'AI-native security operations that bring alerts, correlation, investigation, and case management into one workflow, with human approval for consequential actions.',
    tags: ['Alert ingestion', 'Correlation', 'Investigation', 'Case management', 'Approval gates'],
  },
};
---

<BaseLayout
  title="Products"
  description="The Aegis product family: Aegis GRC, Aegis Amplify, and Aegis Sentinel. AI-native platforms for governance and compliance, revenue operations, and security operations."
  path="/products/"
  schema={[
    breadcrumbSchema(
      [
        { name: 'Aegis', path: '/' },
        { name: 'Products', path: '/products/' },
      ],
      Astro.site,
    ),
  ]}
>
  <PageHero
    eyebrow="Products"
    title="The Aegis product family."
    lede="Three AI-native platforms for revenue, risk, and security, built on the same principles: automation within limits, people approving what matters, and a record of what happened."
    crumbs={[{ name: 'Aegis', href: '/' }, { name: 'Products' }]}
  />

  <section class="section section--tint" aria-label="Products">
    <div class="container list">
      {
        productList.map((p) => (
          <article class="item" data-product={p.id}>
            <div class="art"><ProductMotif product={p.id} /></div>
            <div class="info">
              <p class="cat"><ProductGlyph product={p.id} size={18} />{p.category}</p>
              <h2>{p.name}</h2>
              <p class="lede">{detail[p.id].text}</p>
              <ul class="tags">
                {detail[p.id].tags.map((t) => <li>{t}</li>)}
              </ul>
              <div class="links">
                <a class="btn btn--accent" href={p.path}>Explore {p.name}<Arrow /></a>
                {p.id === 'grc' &&
                  grcFamily.map((c) => (
                    <a class="link-arrow" href={c.path}>
                      {c.name}
                      <Arrow />
                    </a>
                  ))}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="aria-title">
    <div class="container split split--even">
      <div class="stack">
        <span class="eyebrow">Across the family</span>
        <h2 id="aria-title">One approach to AI, applied to each domain.</h2>
      </div>
      <div class="stack">
        <p class="lede">
          Aria is the Aegis intelligence layer: a shared approach to reasoning, orchestration, and
          human control that each product applies to its own work.
        </p>
        <a class="link-arrow" href={ariaPath}>Meet Aria<Arrow /></a>
      </div>
    </div>
  </section>

  <CtaBand
    title="Not sure where to start?"
    text="Start from the problem you want to solve, or tell us about it and we will point you to the right product."
    primary={{ label: 'Browse solutions', href: '/solutions/' }}
    secondary={{ label: 'Contact sales', href: '/contact/' }}
  />
</BaseLayout>

<style>
  .list {
    display: grid;
    gap: clamp(40px, 6vw, 80px);
  }
  .item {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(28px, 5vw, 72px);
    align-items: center;
  }
  .item:nth-child(even) {
    grid-template-columns: 1.2fr 0.8fr;
  }
  .item:nth-child(even) .art {
    order: 2;
  }
  .art {
    padding: 32px;
    border: 1px solid var(--line-2);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(ellipse 80% 90% at 50% 0%, var(--accent-glow), transparent 75%), var(--surface);
  }
  .info {
    display: grid;
    gap: 18px;
    justify-items: start;
  }
  .cat {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--fs-label);
    font-weight: 500;
    color: var(--accent-bright);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 28px;
    margin-top: 6px;
  }
  @media (max-width: 960px) {
    .item,
    .item:nth-child(even) {
      grid-template-columns: 1fr;
    }
    .item:nth-child(even) .art {
      order: 0;
    }
  }
</style>
