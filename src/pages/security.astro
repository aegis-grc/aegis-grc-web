---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import ProductGlyph from '../components/ProductGlyph.astro';
import Arrow from '../components/Arrow.astro';
import { products } from '../data/products';
import { breadcrumbSchema } from '../lib/seo';

const principles = [
  {
    title: 'Secure by design',
    text: 'Security is considered when a feature is designed, not added afterward.',
  },
  {
    title: 'Governed automation',
    text: 'Automation runs inside defined limits, and those limits can be reviewed.',
  },
  {
    title: 'Human approval',
    text: 'Consequential actions are designed to wait for a person to decide.',
  },
  {
    title: 'Auditability',
    text: 'Products record what happened, so teams can review it and explain it later.',
  },
  {
    title: 'Identity and least privilege',
    text: 'Access should be scoped to what a role needs, and sign-in should use the identity systems customers already run.',
  },
  {
    title: 'Data handling',
    text: 'Workflows should use only the data they need, and that data should be protected as it moves and where it is stored.',
  },
  {
    title: 'Responsible AI',
    text: 'AI assists people and is not given unchecked authority. Input from untrusted sources is treated as untrusted, and sensitive data is controlled.',
  },
];

const productDetail = [
  {
    product: products.grc,
    items: [
      'Tenant isolation: each workspace is logically isolated, with scoped access',
      'Encryption in transit and at rest',
      'Tamper-evident audit logging',
    ],
  },
  {
    product: products.sentinel,
    items: [
      'Human approval for consequential actions, with group-based approvals',
      'Bounded autonomy and a kill switch',
      'Entra single sign-on',
      'Tamper-evident audit logging',
      'Prompt-injection defenses and sensitive-data egress controls',
    ],
  },
  {
    product: products.amplify,
    items: ['Security detail for Aegis Amplify is available on request.'],
  },
];
---

<BaseLayout
  title="Security and trust"
  description="How Aegis approaches security: corporate principles for secure design, governed automation, human approval, auditability, identity, data handling, and responsible AI."
  path="/security/"
  schema={[
    breadcrumbSchema(
      [
        { name: 'Aegis', path: '/' },
        { name: 'Security', path: '/security/' },
      ],
      Astro.site,
    ),
  ]}
>
  <PageHero
    eyebrow="Security and trust"
    title="How Aegis approaches security."
    lede="The principles that apply across Aegis products, and where to find product-level detail. This page says plainly what it does and does not cover."
    crumbs={[{ name: 'Aegis', href: '/' }, { name: 'Security' }]}
  />

  <section class="section section--tint" aria-labelledby="principles-title">
    <div class="container split">
      <div class="stack sticky">
        <span class="eyebrow">Corporate principles</span>
        <h2 id="principles-title">How we think about building software people have to trust.</h2>
        <p class="note">
          These are design principles that guide Aegis products. Product-level implementation detail
          is kept separate, below.
        </p>
      </div>
      <ul class="rows">
        {
          principles.map((p) => (
            <li>
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="detail-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Product detail</span>
        <h2 id="detail-title">What each product does today.</h2>
        <p class="lede">
          Specifics belong to the product that implements them. Here is how each product describes
          its own controls.
        </p>
      </div>
      <div class="cols-3">
        {
          productDetail.map((d) => (
            <article class="group" data-product={d.product.id}>
              <h3 class="ph"><ProductGlyph product={d.product.id} size={22} />{d.product.name}</h3>
              <ul class="items">
                {d.items.map((i) => <li>{i}</li>)}
              </ul>
              <a class="link-arrow" href={d.product.path}>About {d.product.name}<Arrow /></a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--tint section--tight" aria-labelledby="certs-title">
    <div class="container split split--even">
      <div class="stack">
        <span class="eyebrow">Certifications and reports</span>
        <h2 id="certs-title">What this page does not list.</h2>
      </div>
      <div class="stack">
        <p class="lede">
          This page does not list certifications, attestations, or audit reports. If your team needs
          current security documentation for a review, ask us and we will tell you exactly what is
          available.
        </p>
        <a class="link-arrow" href="/contact/?topic=security">Ask a security question<Arrow /></a>
      </div>
    </div>
  </section>

  <CtaBand
    title="Questions from your security team?"
    text="We are glad to answer them directly."
    primary={{ label: 'Contact us', href: '/contact/?topic=security' }}
    secondary={{ label: 'Explore the products', href: '/products/' }}
  />
</BaseLayout>

<style>
  .ph {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 1.5rem;
    color: var(--text);
  }
  .ph :global(svg) {
    color: var(--accent-bright);
  }
  .items {
    display: grid;
    gap: 10px;
    color: var(--text-dim);
    font-size: var(--fs-small);
  }
  .items li {
    padding-left: 18px;
    position: relative;
  }
  .items li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 7px;
    height: 1px;
    background: var(--accent);
  }
</style>
