---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Arrow from '../components/Arrow.astro';
import { areas, resources, kindLabels } from '../data/resources';
import { breadcrumbSchema } from '../lib/seo';

const byArea = areas
  .map((a) => ({ ...a, items: resources.filter((r) => r.area === a.id) }))
  .filter((a) => a.items.length > 0);
---

<BaseLayout
  title="Resources"
  description="Product guides and security information for Aegis products, organized by area so the library can grow."
  path="/resources/"
  schema={[
    breadcrumbSchema(
      [
        { name: 'Aegis', path: '/' },
        { name: 'Resources', path: '/resources/' },
      ],
      Astro.site,
    ),
  ]}
>
  <PageHero
    label="Resources"
    title="Guides and information for Aegis products."
    lede="Product guides and security information, organized by area."
    crumbs={[{ name: 'Aegis', href: '/' }, { name: 'Resources' }]}
  />

  <section class="section list" aria-label="Resource library">
    <div class="container">
      {byArea.map((a) => (
        <section class="area" aria-labelledby={`area-${a.id}`}>
          <div class="stack">
            <h2 id={`area-${a.id}`}>{a.title}</h2>
            <p class="muted">{a.blurb}</p>
          </div>
          <ul class="items">
            {a.items.map((r) => (
              <li>
                <a href={r.href}>
                  <span class="kind mono">{kindLabels[r.kind]}</span>
                  <span class="title">{r.title}</span>
                  <span class="sum">{r.summary}</span>
                  <Arrow />
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </section>

  <CtaBand
    title="Looking for something specific?"
    text="Ask us for product materials and we will tell you what is available for your use case."
    primary={{ label: 'Ask for materials', href: '/contact/?topic=resources' }}
    secondary={{ label: 'Explore the products', href: '/products/' }}
  />
</BaseLayout>

<style>
  .list {
    padding-top: clamp(24px, 4vw, 56px);
  }
  .area {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(24px, 6vw, 104px);
    padding: clamp(32px, 4vw, 52px) 0;
    border-top: 1px solid var(--line-2);
  }
  .area:first-child {
    border-top: 0;
  }
  h2 {
    font-size: clamp(1.75rem, 1.3rem + 1.8vw, 2.75rem);
    letter-spacing: -0.04em;
  }
  .items a {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4px 16px;
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
    transition: background var(--t-fast) var(--ease);
  }
  .items li:first-child a {
    border-top: 1px solid var(--line-2);
  }
  .kind {
    grid-column: 1;
    color: var(--text-faint);
  }
  .title {
    grid-column: 1;
    font-size: 1.1875rem;
    font-weight: 560;
    letter-spacing: -0.015em;
  }
  .sum {
    grid-column: 1;
    font-size: var(--fs-small);
    color: var(--text-dim);
  }
  .items a :global(svg) {
    grid-column: 2;
    grid-row: 1 / span 3;
    align-self: center;
    width: 18px;
    height: 18px;
    color: var(--text-faint);
    transition:
      transform 160ms var(--ease),
      color var(--t-fast) var(--ease);
  }
  @media (hover: hover) {
    .items a:hover .title {
      color: var(--blue-text);
    }
    .items a:hover :global(svg) {
      transform: translateX(3px);
      color: var(--blue-text);
    }
  }
  @media (max-width: 960px) {
    .area {
      grid-template-columns: 1fr;
    }
  }
</style>
