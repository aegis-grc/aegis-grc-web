---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ProductGlyph from '../components/ProductGlyph.astro';
import Arrow from '../components/Arrow.astro';
import { productList } from '../data/products';
import { breadcrumbSchema } from '../lib/seo';
---

<BaseLayout
  title="Sign in"
  description="Sign in to your Aegis product: Aegis GRC, Aegis Amplify, or Aegis Sentinel."
  path="/sign-in/"
  schema={[
    breadcrumbSchema(
      [
        { name: 'Aegis', path: '/' },
        { name: 'Sign in', path: '/sign-in/' },
      ],
      Astro.site,
    ),
  ]}
>
  <PageHero
    eyebrow="Sign in"
    title="Sign in to your Aegis product."
    lede="Each Aegis product is its own application. Choose the one you use."
    crumbs={[{ name: 'Aegis', href: '/' }, { name: 'Sign in' }]}
  />

  <section class="section section--tint" aria-label="Choose a product">
    <div class="container">
      <ul class="choices">
        {
          productList.map((p) => (
            <li class="choice" data-product={p.id}>
              <span class="g"><ProductGlyph product={p.id} size={24} /></span>
              <h2>{p.name}</h2>
              <p class="muted">{p.category}</p>
              {p.appUrl ? (
                <a class="btn btn--accent" href={p.appUrl} rel="noopener">
                  Sign in to {p.name}
                  <Arrow />
                </a>
              ) : (
                <p class="pending">
                  Your {p.name} sign-in link comes from your administrator or your Aegis contact.
                  <a href="/contact/">Need help? Contact us</a>
                </p>
              )}
            </li>
          ))
        }
      </ul>
      <p class="note">
        New to Aegis? <a href="/products/">Explore the products</a> or <a href="/contact/">contact sales</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .choices {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .choice {
    display: grid;
    gap: 12px;
    align-content: start;
    padding: 30px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-top: 2px solid var(--accent);
    border-radius: var(--radius-lg);
  }
  .g {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    border: 1px solid var(--accent-line);
    background: var(--accent-soft);
    color: var(--accent-bright);
  }
  h2 {
    font-size: 1.75rem;
  }
  .choice .btn {
    justify-self: start;
    margin-top: 10px;
  }
  .pending {
    margin-top: 10px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    font-size: var(--fs-small);
    color: var(--text-dim);
  }
  .pending a,
  .note a {
    display: block;
    margin-top: 6px;
    color: var(--accent-bright);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .note {
    margin-top: 32px;
  }
  .note a {
    display: inline;
    margin: 0;
  }
  @media (max-width: 960px) {
    .choices {
      grid-template-columns: 1fr;
      max-width: 520px;
    }
  }
</style>
