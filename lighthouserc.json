{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "http://localhost/index.html",
        "http://localhost/products/index.html",
        "http://localhost/products/grc/index.html",
        "http://localhost/products/grc/contracts/index.html",
        "http://localhost/products/grc/qms/index.html",
        "http://localhost/products/amplify/index.html",
        "http://localhost/products/sentinel/index.html",
        "http://localhost/platform/intelligence/index.html",
        "http://localhost/solutions/index.html",
        "http://localhost/industries/index.html",
        "http://localhost/security/index.html",
        "http://localhost/resources/index.html",
        "http://localhost/company/index.html",
        "http://localhost/contact/index.html",
        "http://localhost/sign-in/index.html"
      ],
      "numberOfRuns": 1,
      "settings": { "preset": "desktop" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.9 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci/reports" }
  }
}
